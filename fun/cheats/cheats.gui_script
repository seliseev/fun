--- Чит-панель FUN: кнопка CHEATS поверх всех экранов, по нажатию - окно на весь экран с вкладками из fun.cheats.
--- В debug-движке над ней - FPS, график длительности кадров и память (процесс и Lua).
--- Все ноды создаются кодом. Ввод: объекту панели нужен acquire_input_focus после прокси игры,
--- тогда панель получает нажатия раньше экранов. Закрытие - кнопка X или действие key_back.

local druid = require("druid.druid")
local cheats = require("fun.cheats.cheats")

local FONT = "default"
local WIDTH = 390
local BG = vmath.vector4(0.08, 0.09, 0.13, 0.96)
local TAB_ACTIVE = vmath.vector4(0.25, 0.45, 0.9, 1)
local TAB_IDLE = vmath.vector4(0.25, 0.27, 0.33, 1)
local ACTION = vmath.vector4(0.2, 0.55, 0.3, 1)
local MINUS = vmath.vector4(0.6, 0.25, 0.25, 1)
local DANGER = vmath.vector4(0.8, 0.2, 0.2, 1)
local FIELD_COLOR = vmath.vector4(0.25, 0.27, 0.33, 1)
local CONFIRM_TIME = 3
local DELTAS = { -1000, -100, -10, -1, 1, 10, 100, 1000 }
local DELTA_SIZE = 40
local DELTA_STEP = 43
local FIELD_WIDTH = 74
local MAX_DIGITS = 9
local ZERO = vmath.vector3()

local BARS = 40
local BAR_WIDTH = 2
local GRAPH_HEIGHT = 16
local FRAME_60 = 1 / 60
local STATS_INTERVAL = 0.5
local MB = 1024 * 1024
local GREEN = vmath.vector4(0.3, 0.9, 0.3, 1)
local YELLOW = vmath.vector4(1, 0.8, 0.2, 1)
local RED = vmath.vector4(1, 0.3, 0.3, 1)

local function box(parent, pos, size, color)
	local node = gui.new_box_node(pos, size)
	gui.set_color(node, color)
	if parent then
		gui.set_parent(node, parent)
	end
	return node
end

--- Невидимая нода-контейнер: дети рисуются
local function group(parent, pos)
	local node = box(parent, pos, vmath.vector3(1, 1, 0), vmath.vector4(1))
	gui.set_visible(node, false)
	return node
end

local function label(parent, pos, value, scale, pivot)
	local node = gui.new_text_node(pos, value)
	gui.set_font(node, FONT)
	gui.set_scale(node, vmath.vector3(scale, scale, 1))
	gui.set_pivot(node, pivot or gui.PIVOT_CENTER)
	gui.set_parent(node, parent)
	return node
end

local function button(self, parent, pos, size, color, value, scale, on_click)
	local node = box(parent, pos, size, color)
	local text = label(node, ZERO, value, scale)
	self.druid:new_button(node, on_click)
	return node, text
end

--- Строки, которые обновляются каждый кадр, пока страница открыта
local function on_update(page, fn)
	table.insert(page.updates, fn)
end

local function add_reset(self, page, y)
	local text
	local confirm_timer
	local function on_click()
		if confirm_timer then
			timer.cancel(confirm_timer)
			confirm_timer = nil
			gui.set_text(text, "RESETTING...")
			cheats.reset_progress()
			return
		end
		gui.set_text(text, "TAP AGAIN TO RESET")
		confirm_timer = timer.delay(CONFIRM_TIME, false, function()
			confirm_timer = nil
			gui.set_text(text, "RESET PROGRESS")
		end)
	end
	_, text = button(self, page.node, vmath.vector3(0, y - 30, 0), vmath.vector3(WIDTH, 60, 0), DANGER,
		"RESET PROGRESS", 1.6, on_click)
	return 80
end

local function add_button(self, page, y, item)
	local dynamic = type(item.text) == "function"
	local _, text = button(self, page.node, vmath.vector3(0, y - 30, 0), vmath.vector3(WIDTH, 60, 0), ACTION,
		dynamic and item.text() or item.text, 1.6, item.on_click)
	if dynamic then
		on_update(page, function() gui.set_text(text, item.text()) end)
	end
	return 80
end

local function add_value(self, page, y, item)
	local function set(value)
		item.set(math.max(0, math.floor(value)))
	end
	label(page.node, vmath.vector3(-WIDTH / 2, y - 14, 0), item.title, 1.4, gui.PIVOT_W)
	local row_y = y - 48
	for i, delta in ipairs(DELTAS) do
		local side = i <= #DELTAS / 2 and -1 or 1
		local k = side < 0 and (#DELTAS / 2 + 1 - i) or (i - #DELTAS / 2) -- 1 - у поля
		local x = side * (FIELD_WIDTH / 2 + 3 + DELTA_SIZE / 2 + (k - 1) * DELTA_STEP)
		button(self, page.node, vmath.vector3(x, row_y, 0), vmath.vector3(DELTA_SIZE, DELTA_SIZE, 0),
			side < 0 and MINUS or ACTION, (delta > 0 and "+" or "") .. delta, 0.75,
			function() set(item.get() + delta) end)
	end
	local field = box(page.node, vmath.vector3(0, row_y, 0), vmath.vector3(FIELD_WIDTH, DELTA_SIZE, 0), FIELD_COLOR)
	local text = label(field, ZERO, "0", 1.3)
	-- druid ужимает текст под размер ноды: размер - по полю
	gui.set_size(text, vmath.vector3((FIELD_WIDTH - 6) / 1.3, DELTA_SIZE, 0))
	local input = self.druid:new_input(field, text, gui.KEYBOARD_TYPE_NUMBER_PAD)
	input:set_allowed_characters("[%d]")
	input:set_max_length(MAX_DIGITS)
	-- Набранное число заменяет значение, а не дописывается к нему
	input.on_input_select:subscribe(function() input:set_text("") end)
	input.on_input_unselect:subscribe(function(_, value)
		if tonumber(value) then
			set(tonumber(value))
		end
	end)
	-- Поле показывает текущее значение, пока его не редактируют
	on_update(page, function()
		local value = tostring(item.get())
		if not input.is_selected and input:get_text() ~= value then
			input:set_text(value)
		end
	end)
	return 84
end

local function add_events(self, page, y, item)
	local index = 1
	local function event() return item.events[index] end
	local size = vmath.vector3(WIDTH, 56, 0)
	local _, select_text = button(self, page.node, vmath.vector3(0, y - 22, 0), vmath.vector3(WIDTH, 44, 0),
		FIELD_COLOR, "", 1.4, function() index = index % #item.events + 1 end)
	local status = label(page.node, vmath.vector3(0, y - 72, 0), "", 1.4)
	button(self, page.node, vmath.vector3(0, y - 130, 0), size, ACTION, "GET NEXT REWARD", 1.5,
		function() event().to_reward(0) end)
	button(self, page.node, vmath.vector3(0, y - 200, 0), size, ACTION, "NEXT REWARD - 1", 1.5,
		function() event().to_reward(1) end)
	local _, type_text = button(self, page.node, vmath.vector3(0, y - 270, 0), size, ACTION, "", 1.5,
		function() event().next_type() end)
	on_update(page, function()
		gui.set_text(select_text, "Event: " .. event().title .. (#item.events > 1 and "  >" or ""))
		gui.set_text(status, event().status())
		gui.set_text(type_text, "TYPE: " .. string.upper(event().get_type()))
	end)
	return 310
end

--- FPS и память: левый верхний угол со сдвигом cheats.stats_offset
local function create_stats(self, top)
	local offset = cheats.stats_offset
	self.stats = box(nil, vmath.vector3(offset.x, top + offset.y, 0), vmath.vector3(124, 46, 0), vmath.vector4(0, 0, 0, 0.6))
	gui.set_pivot(self.stats, gui.PIVOT_NW)
	gui.set_xanchor(self.stats, gui.ANCHOR_LEFT)
	gui.set_yanchor(self.stats, gui.ANCHOR_TOP)
	self.stats_text = label(self.stats, vmath.vector3(4, -3, 0), "", 0.7, gui.PIVOT_NW)
	gui.set_line_break(self.stats_text, true)
	gui.set_size(self.stats_text, vmath.vector3(118 / 0.7, 50, 0))
	self.bars = {}
	for i = 1, BARS do
		local bar = box(self.stats, ZERO, vmath.vector3(BAR_WIDTH, 1, 0), GREEN)
		gui.set_pivot(bar, gui.PIVOT_SW)
		self.bars[i] = bar
	end
	self.next_bar = 1
	self.elapsed = 0
	self.count = 0
end

local function update_stats(self, dt)
	-- Столбик - длительность кадра: 1/60 с - четверть высоты, 4/60 с (15 FPS) и дольше - вся высота
	local bar = self.bars[self.next_bar]
	gui.set_size(bar, vmath.vector3(BAR_WIDTH, math.min(GRAPH_HEIGHT, math.max(1, dt / FRAME_60 * GRAPH_HEIGHT / 4)), 0))
	gui.set_color(bar, dt <= FRAME_60 * 1.2 and GREEN or dt <= FRAME_60 * 2 and YELLOW or RED)
	-- Самый новый столбик справа: сдвигаем всю ленту
	for i = 1, BARS do
		local index = (self.next_bar + i - 1) % BARS + 1
		gui.set_position(self.bars[index], vmath.vector3(2 + (i - 1) * (BAR_WIDTH + 1), -44, 0))
	end
	self.next_bar = self.next_bar % BARS + 1

	self.elapsed = self.elapsed + dt
	self.count = self.count + 1
	if self.elapsed >= STATS_INTERVAL then
		local fps = self.count / self.elapsed
		self.elapsed, self.count = 0, 0
		gui.set_text(self.stats_text, string.format("%d FPS\n%.0f MB  Lua %.1f MB", fps + 0.5,
			profiler.get_memory_usage() / MB, collectgarbage("count") / 1024))
	end
end

local ADD = { reset = add_reset, button = add_button, value = add_value, events = add_events }

local function select_tab(self, page)
	self.page = page
	for _, other in ipairs(self.pages) do
		gui.set_color(other.tab, other == page and TAB_ACTIVE or TAB_IDLE)
		gui.set_enabled(other.node, other == page)
	end
end

--- Окно строится при первом открытии: к этому времени игра зарегистрировала пункты
local function build(self)
	local width = sys.get_config_int("display.width", 640)
	local height = sys.get_config_int("display.height", 960)
	self.panel = box(nil, vmath.vector3(width / 2, height / 2, 0), vmath.vector3(width, height, 0), BG)
	gui.set_adjust_mode(self.panel, gui.ADJUST_STRETCH)
	self.content = group(nil, vmath.vector3(width / 2, height - self.inset - 40, 0))
	gui.set_yanchor(self.content, gui.ANCHOR_TOP)
	label(self.content, vmath.vector3(-WIDTH / 2, 0, 0), "CHEATS", 2.2, gui.PIVOT_W)
	button(self, self.content, vmath.vector3(WIDTH / 2 - 24, 0, 0), vmath.vector3(48, 48, 0), TAB_IDLE, "X", 2,
		function() self.set_open(false) end)

	local count = #cheats.tabs
	local tab_width = math.min(120, (WIDTH - (count - 1) * 10) / count)
	self.pages = {}
	for i, tab in ipairs(cheats.tabs) do
		local page = { node = group(self.content, vmath.vector3(0, -100, 0)), updates = {} }
		local x = -WIDTH / 2 + tab_width / 2 + (i - 1) * (WIDTH - tab_width) / math.max(1, count - 1)
		page.tab = button(self, self.content, vmath.vector3(count > 1 and x or 0, -56, 0),
			vmath.vector3(tab_width, 40, 0), TAB_IDLE, tab.title, 1.4, function() select_tab(self, page) end)
		local y = 0
		for _, item in ipairs(tab.items) do
			y = y - ADD[item.type](self, page, y, item)
		end
		table.insert(self.pages, page)
	end
	select_tab(self, self.pages[1])
end

function init(self)
	-- Поверх всех экранов: 15 - наибольший порядок GUI
	gui.set_render_order(15)
	self.druid = druid.new(self)
	local _, window_height = window.get_size()
	local display_height = sys.get_config_int("display.height", 960)
	self.inset = (window.get_safe_area().inset_top or 0) * display_height / math.max(1, window_height)

	if sys.get_engine_info().is_debug then
		create_stats(self, display_height - self.inset)
	end

	local offset = cheats.open_offset
	self.open, self.open_text = button(self, nil,
		vmath.vector3(offset.x + 38, display_height - self.inset + offset.y - 14, 0), vmath.vector3(76, 28, 0),
		vmath.vector4(0, 0, 0, 0.6), "CHEATS", 1, function() self.set_open(true) end)
	gui.set_xanchor(self.open, gui.ANCHOR_LEFT)
	gui.set_yanchor(self.open, gui.ANCHOR_TOP)

	self.is_open = false
	self.set_open = function(open)
		if open and not self.panel then
			build(self)
		end
		self.is_open = open
		if self.panel then
			gui.set_enabled(self.panel, open)
			gui.set_enabled(self.content, open)
		end
		gui.set_enabled(self.open, not open)
	end
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	local enabled = cheats.enabled
	if gui.is_enabled(self.open) ~= (enabled and not self.is_open) then
		if not enabled then
			self.set_open(false)
		end
		gui.set_enabled(self.open, enabled and not self.is_open)
	end
	if self.stats then
		gui.set_enabled(self.stats, enabled)
		if enabled then
			update_stats(self, dt)
		end
	end
	self.druid:update(dt)
	if self.is_open then
		for _, fn in ipairs(self.page.updates) do
			fn()
		end
	end
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if not cheats.enabled then
		return false
	end
	if self.is_open and action_id == hash("key_back") then
		if action.released then
			self.set_open(false)
		end
		return true
	end
	-- Открытая панель забирает весь ввод: экраны под ней нажатий не получают
	return self.druid:on_input(action_id, action) or self.is_open
end
