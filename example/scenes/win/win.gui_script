local monarch = require "monarch.monarch"
local events = require("event.events")
local druid = require("druid.druid")
local log = require("fun.libs.log")

local const = require("fun.const")
local luax = require("fun.luax")
local lang = require("fun.modules.lang")
local gamedata = require("fun.modules.gamedata")
local adsservice = require("fun.modules.adsservice")
local wallet = require("fun.modules.wallet")

local game_const = require("example.const")
local widget_monarch_transition = require("example.widgets.monarch_transition")

local logger = log.get_logger("win.gui_script")

local TEXT_KEY_TITLE = "win.title"
local TEXT_KEY_BUTTON_CONTINUE = "win.button.continue"
local TEXT_KEY_BUTTON_RW = "win.button.rw"

---@class win.gui_script
---@field druid druid.instance
---@field button_continue druid.button
---@field button_rw druid.button
---@field button_continue_text druid.rich_text
---@field button_rw_text druid.rich_text
---@field node_glow userdata

--- @type table
local config_level_gold_reward = {
    default =  100,
    rewarded_mult = 2
}

--- Анимация победного экрана
---@param self win.gui_script
local function play_animation(self)
    local original_scale = gui.get_scale(self.node_glow)
    gui.set_visible(self.node_glow, true)
    gui.animate(self.node_glow, "euler.z", -360, gui.EASING_LINEAR, 6, 0, nil, gui.PLAYBACK_LOOP_FORWARD)
    gui.animate(self.node_glow, "scale", original_scale*2, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    timer.delay(2, false, function()
        gui.animate(self.node_glow, "color.w", 0.4, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
    end)
end

----------------------------------------
--- Event handlers ---------------------
----------------------------------------

local function on_language_change(self)
    local btn_continue_text = lang.txt(TEXT_KEY_BUTTON_CONTINUE, luax.string.split_by_rank(config_level_gold_reward.default))
    local btn_rw_text = lang.txt(TEXT_KEY_BUTTON_RW, config_level_gold_reward.rewarded_mult, luax.string.split_by_rank(config_level_gold_reward.default * config_level_gold_reward.rewarded_mult))
    self.button_continue_text:set_text(btn_continue_text)
    self.button_rw_text:set_text(btn_rw_text)
end

local function on_adsservice_rewarded_close(self)
    monarch.show(game_const.MONARCH_SCENES.HUD, { clear = true })
end

local function on_adsservice_rewarded_reward(self)
    wallet.add(game_const.TOKEN.GOLD, config_level_gold_reward.default, "gameplay", "win", true)

    local reward_from_ad = config_level_gold_reward.rewarded_mult*config_level_gold_reward.default - config_level_gold_reward.default
    wallet.add(game_const.TOKEN.GOLD, reward_from_ad, "AD", "win", true)
end

local function on_adsservice_interstitial_close(self, placement_id)
    if placement_id == game_const.AD_INTERSTITIAL_PLACEMENTS.LEVEL_WIN then
        monarch.show(game_const.MONARCH_SCENES.HUD, { clear = true })
    end
end

--- Колбэк на нажатие на кнопку "Продолжить"
---@param self win.gui_script
local function on_button_continue(self)
    wallet.add(game_const.TOKEN.GOLD, config_level_gold_reward.default, "gameplay", "win", true)

    if not adsservice.show_interstitial(game_const.AD_INTERSTITIAL_PLACEMENTS.LEVEL_WIN) then
        monarch.show(game_const.MONARCH_SCENES.HUD, { clear = true })
    end
end

--- Колбэк на нажатие на кнопку "Умножить награду за Rewarded Video"
---@param self win.gui_script
local function on_button_rw(self)
    if not adsservice.show_rewarded(game_const.RW_PLACEMENTS.LEVEL_WIN) then
        --- TODO: show popup with error message
        logger:error("Failed to show rewarded ad")
        return
    end
end

----------------------------------------
--- Defold functions -------------------
----------------------------------------

function init(self)
    msg.post(".", "acquire_input_focus")
    config_level_gold_reward = gamedata.get_module_config("level_gold_reward", config_level_gold_reward)
    assert(config_level_gold_reward, "level_gold_reward config is nil")

    self.druid = druid.new(self)

    self.button_continue = self.druid:new_button("continue/button", on_button_continue, self)
    self.button_continue_text = self.druid:new_rich_text("continue/text")

    self.title = self.druid:new_rich_text("title", lang.txt(TEXT_KEY_TITLE))

    self.button_rw = self.druid:new_button("rw/button", on_button_rw, self)
    self.button_rw_text = self.druid:new_rich_text("rw/text")
    on_language_change(self)

    self.node_glow = gui.get_node("glow")

    gui.set_enabled(self.button_rw.node, adsservice.is_rewarded_ready() and adsservice.can_show_rewarded(game_const.RW_PLACEMENTS.LEVEL_WIN))

    -------- TRANSITION --------
    ---@type widget.monarch_transition
    self.monarch_transition = self.druid:new_widget(widget_monarch_transition, nil, nil, game_const.MONARCH_SCENES.WIN)
    self.monarch_transition.event_transition_done:subscribe(function ()
        msg.post(".", hash("play"))
    end, self)

    events.subscribe(const.EVENTS.LANG_UPDATE, on_language_change, self)
    adsservice.on_rewarded_close:subscribe(on_adsservice_rewarded_close, self)
    adsservice.on_rewarded_reward:subscribe(on_adsservice_rewarded_reward, self)
    adsservice.on_interstitial_close:subscribe(on_adsservice_interstitial_close, self)
end

function final(self)
    self.druid:final()
    events.unsubscribe(const.EVENTS.LANG_UPDATE, on_language_change, self)
    adsservice.on_rewarded_close:unsubscribe(on_adsservice_rewarded_close, self)
    adsservice.on_rewarded_reward:unsubscribe(on_adsservice_rewarded_reward, self)
    adsservice.on_interstitial_close:unsubscribe(on_adsservice_interstitial_close, self)
end

function update(self, dt)
    self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("play") then
        play_animation(self)
    end

    self.druid:on_message(message_id, message, sender)
    monarch.on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
    return self.druid:on_input(action_id, action)
end

function on_reload(self)
end
