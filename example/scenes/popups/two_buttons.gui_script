local monarch = require "monarch.monarch"
local druid = require("druid.druid")
local game_const = require("example.const")

local logger = require("fun.libs.log").get_logger("two_buttons.gui_script")

--- @class game.scenes.popups.two_buttons.data
--- @field title_text_key string
--- @field description_text_key string
--- @field button_left_text_key string
--- @field button_left_callback function
--- @field button_right_text_key string
--- @field button_right_callback function


function init(self)
    msg.post(".", "acquire_input_focus")

    --- @type game.scenes.popups.two_buttons.data
    local data = monarch.data(game_const.MONARCH_SCENES.POPUP_TWO_BUTTONS)
    if not data then
        logger:error("Data not found for popup one button")
        monarch.back()
    end

    self.druid = druid.new(self)

    self.druid:new_lang_text("title", data.title_text_key)
    self.druid:new_lang_text("description", data.description_text_key)
    self.druid:new_lang_text("button_left/text", data.button_left_text_key)
    self.druid:new_lang_text("button_right/text", data.button_right_text_key)

    self.druid:new_button("button_left/button", data.button_left_callback)
    self.druid:new_button("button_right/button", data.button_right_callback)
end

function final(self)
    self.druid:final()
end

function update(self, dt)
    self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
    return self.druid:on_input(action_id, action)
end

function on_reload(self)
end
