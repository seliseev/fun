local druid = require("druid.druid")

local function animate_nodes(animation_nodes, animation_duration, delay)
    local real_delay = 0
        for _, node in ipairs(animation_nodes) do
            local start_position = gui.get_position(node)
            gui.animate(node, "position.y", start_position.y+50, gui.EASING_INSINE, animation_duration*0.3, real_delay, function ()
                gui.animate(node, "position.y", start_position.y, gui.EASING_OUTBOUNCE, animation_duration*0.7, 0, function ()
                end)
            end)
            real_delay = real_delay + delay
        end
end


function init(self)
    msg.post(".", "acquire_input_focus")

    self.druid = druid.new(self)
    self.text = self.druid:new_lang_text("text", "loading.text")

    local animation_duration = 1
    local delay = 0.2
    local animation_nodes = {
        gui.get_node("loading_w"),
        gui.get_node("loading_o"),
        gui.get_node("loading_r"),
        gui.get_node("loading_d")
    }
    animate_nodes(animation_nodes, animation_duration, delay)
    
    self.handle = timer.delay((delay*#animation_nodes+animation_duration), true, function(self, handle, time_lapsed)
        animate_nodes(animation_nodes, animation_duration, delay)
    end)
end

function final(self)
    timer.cancel(self.handle)
    self.druid:final()
end

function update(self, dt)
    self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
    return self.druid:on_input(action_id, action)
end

function on_reload(self)
end
