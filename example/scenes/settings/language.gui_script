local monarch = require("monarch.monarch")
local druid = require("druid.druid")
local lang = require("fun.modules.lang")

local game_const = require("example.const")
local widget_monarch_transition = require("example.widgets.monarch_transition")
local widget_toggle_button = require("example.widgets.toggle_button")


---@class settings.language.gui_script
---@field druid druid.instance
---@field prefab userdata
---@field current_language string
---@field title druid.lang_text
---@field subtitle druid.lang_text
---@field btn_apply_text druid.lang_text
---@field btn_close druid.button
---@field back_handler druid.back_handler
---@field btn_apply druid.button
---@field scroll druid.scroll
---@field grid druid.grid
---@field data_list druid.data_list
---@field monarch_transition druid.widget

--- Закрывает окно настроек языка
---@param self settings.language.gui_script
local function close(self)
    -- Если игрок поменял язык, но не применил изменения, то возвращаемся к предыдущему языку
    if self.current_language ~= lang.get_lang() then
        lang.set_lang(self.current_language)
    end

    monarch.hide(game_const.MONARCH_SCENES.LANGUAGE)
end


local function on_lang_click(self, iso_code, enabled)
    if enabled then
        lang.set_lang(iso_code)
        for _, toggle in pairs(self.data_list:get_created_components()) do
            if toggle:get_id() == iso_code then
                toggle:set_enabled(true)
            else
                toggle:set_enabled(false)
            end
        end
    end
end

---@param data table
---@param index number
---@param data_list druid.data_list
---@return node, druid.component
local function create_item_callback(self, data, index, data_list)
    local nodes = gui.clone_tree(self.prefab)
    local node_root = nodes["prefab/root"]
    gui.set_enabled(node_root, true)

    --- @type widget.toggle_button
    local toggle_button = self.druid:new_widget(widget_toggle_button, "prefab", nodes)
    toggle_button:set_lang_text(data.localization_key)
    toggle_button:set_id(data.iso_code)

    if data.iso_code == lang.get_lang() then
        toggle_button:set_enabled(true)
    else
        toggle_button:set_enabled(false)
    end

    toggle_button:set_on_toggle_function(on_lang_click, self)

    return node_root, toggle_button
end


---@param self settings.language.gui_script
function init(self)

    --- @type druid.instance
    self.druid = druid.new(self)

    self.prefab = gui.get_node("prefab/root")
    gui.set_enabled(self.prefab, false)

    self.current_language = lang.get_lang()

    --- @type druid.lang_text
	self.title = self.druid:new_lang_text("title", "settings.language.title")
    self.subtitle = self.druid:new_lang_text("subtitle", "settings.language.subtitle")
    self.btn_apply_text = self.druid:new_lang_text("apply/text", "settings.language.apply")

    self.btn_close = self.druid:new_button("btn_close/root", close, self)

    self.back_handler = self.druid:new_back_handler(close, self)

    self.btn_apply = self.druid:new_button("apply/button", function()
        monarch.hide(game_const.MONARCH_SCENES.LANGUAGE)
    end)

    self.scroll = self.druid:new_scroll("view", "content")
	self.grid = self.druid:new_grid("content", self.prefab, 1)
    --- @type druid.data_list
	self.data_list = self.druid:new_data_list(self.scroll, self.grid, create_item_callback) --[[@as druid.data_list]]
    
    local data = {}
    for _, iso_code in ipairs(lang.get_langs()) do
        table.insert(data, {
            localization_key = string.format("settings.language.%s", iso_code),
            iso_code = iso_code,
        })
    end
    
    self.data_list:set_data(data)

    self.monarch_transition = self.druid:new_widget(widget_monarch_transition, nil, nil, game_const.MONARCH_SCENES.LANGUAGE)
end



function final(self)
    self.druid:final()
end

function update(self, dt)
    self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)
    monarch.on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
    return self.druid:on_input(action_id, action)
end
