local druid = require("druid.druid")
local monarch = require("monarch.monarch")

local game_const = require("example.const")
local level_manager = require("example.modules.level_manager")

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)
    
    self.node_root = gui.get_node("root")
	self.memory_text = self.druid:new_text("memory_text")

	--- @type druid.button
	self.button_cheats = self.druid:new_button("button", function()
		if monarch.is_visible("cheats") then
			monarch.hide(game_const.MONARCH_SCENES.CHEATS)
		else
			monarch.show(game_const.MONARCH_SCENES.CHEATS)
		end
	end)

	--- @type druid.button
	self.button_win = self.druid:new_button("win", function()
		if monarch.is_visible(game_const.MONARCH_SCENES.LEVEL) then
			level_manager.complete()
		end
	end)

	--- @type druid.button
	self.button_hide = self.druid:new_button("hide", function()
		gui.set_enabled(self.node_root, false)
	end)

	-- выставляем оверлей читов на самый верхний слой, чтобы она была видна
	gui.set_render_order(15)

	-- Если билд релизный (не девелоперский), то скрываем кнопку читов
	if sys.get_engine_info().is_debug then
		gui.set_enabled(self.node_root, true)
	else
		gui.set_enabled(self.node_root, false)
	end
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
	self.memory_text:set_text(string.format("Memory: %d KB", collectgarbage("count")))
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
