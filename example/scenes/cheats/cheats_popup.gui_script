local druid = require("druid.druid")
local monarch = require("monarch.monarch")

local game_const = require("example.const")
local wallet = require("fun.modules.wallet")
local levelchest = require("fun.modules.levelchest")
local iap = require("fun.modules.iap.iap")
local adsservice = require("fun.modules.adsservice")
local saver = require("fun.modules.saver")
local game = require("fun.modules.game")
local noads = require("fun.modules.noads")

local level_manager = require("example.modules.level_manager")

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)

	self.druid:new_button("complete", function()
		level_manager.complete()
	end)

	self.druid:new_button("restart", function()
		level_manager.restart()
	end)

	self.druid:new_button("btn_close", function()
		monarch.hide(game_const.MONARCH_SCENES.CHEATS)
	end)

	self.druid:new_button("add_gold_100", function()
		wallet.add(game_const.TOKEN.GOLD, 1000, "cheats", "", true)
	end)

	self.druid:new_button("add_gold_500", function()
		wallet.add(game_const.TOKEN.GOLD, 5000, "cheats", "", false)
	end)

	self.druid:new_button("add_gold_1000", function()
		wallet.add(game_const.TOKEN.GOLD, 10000, "cheats", "", false)
	end)

	self.druid:new_button("add_levelchest_1", function()
		levelchest.get_current():add_value(1)
	end)

	self.druid:new_button("add_levelchest_5", function()
		levelchest.get_current():add_value(5)
	end)

	self.druid:new_button("add_levelchest_10", function()
		levelchest.get_current():add_value(10)
	end)

	self.druid:new_button("iap_purchased", function()
		iap.purchase("android.test.purchased")
	end)

	self.druid:new_button("iap_cancelled", function()
		iap.purchase("android.test.canceled")
	end)

	self.druid:new_button("iap_refunded", function()
		iap.purchase("android.test.refunded")
	end)

	self.druid:new_button("iap_unavailable", function()
		iap.purchase("android.test.item_unavailable")
	end)

	self.druid:new_button("show_rate_us", function ()
		monarch.hide(game_const.MONARCH_SCENES.CHEATS)
		monarch.show(game_const.MONARCH_SCENES.RATEUS)
	end)

	self.druid:new_button("ads_rw", function()
		adsservice.show_rewarded(game_const.RW_PLACEMENTS.LEVEL_WIN, true)
	end)

	self.druid:new_button("ads_inter", function()
		adsservice.show_interstitial(game_const.AD_INTERSTITIAL_PLACEMENTS.LEVEL_WIN, true)
	end)

    self.druid:new_button("adinfo", function()
		if adinfo then
			adinfo.get(function(self,info)
				print("AdInfo: ")
				pprint(info)
			end)
		else
			print("AdInfo is not available")
		end
	end)

	self.druid:new_button("admob_inspector", function()
		if admob then
		    admob.show_ad_inspector()
		else
			print("AdMob is not available")
		end
	end)

	self.druid:new_button("ads_disable", function()
		if adsservice.runtime.is_enabled then
			adsservice.disable_ads()
		else
			adsservice.enable_ads()
		end
	end)

	self.druid:new_button("reset", function ()
		saver.clear()
		game.reboot()
	end)

	self.druid:new_button("noads", function()
		if noads.is_purchased() then
			noads.reset()
		else
			noads.purchase()
		end
		gui.set_text(gui.get_node("noads_status"), noads.is_purchased() and "NoAds Purchased: Yes" or "NoAds Purchased: No")
	end)
	gui.set_text(gui.get_node("noads_status"), noads.is_purchased() and "NoAds Purchased: Yes" or "NoAds Purchased: No")

	-- self.druid:new_button("16x9", function ()
	-- 	msg.post("@render:", "resize", { width = 1280, height = 720 } )
	-- end)
	-- self.druid:new_button("9x16", function ()
	-- 	msg.post("@render:", "resize", { width = 720, height = 1280 } )
	-- end)
end

function final(self)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end