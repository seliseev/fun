--- HUD - главное меню игры

local events = require("event.events")
local monarch = require ("monarch.monarch")
local druid = require ("druid.druid")

local const = require("fun.const")
local levelchest = require("fun.modules.levelchest")
local vibrate = require("fun.modules.vibrate")
local game = require("fun.modules.game")
local adsservice = require("fun.modules.adsservice")
local rateus = require("fun.modules.rateus")
local noads = require("fun.modules.noads")

local game_const = require("example.const")
local level_manager = require("example.modules.level_manager")
local widget_counter = require("example.widgets.counter")
local widget_event_icon = require("example.widgets.event_icon")
local widget_monarch_transition = require("example.widgets.monarch_transition")
local widget_safearea = require("example.widgets.safearea")
local widget_bannersafearea = require("example.widgets.bannersafearea")
local widget_monarch_focus_listener = require("example.widgets.monarch_focus_listener")
local widget_accrual = require("example.widgets.accrual")


---@class hud.gui_script
---@field node_level_number userdata
---@field druid druid.instance
---@field safearea widget.safearea
---@field bannersafearea widget.bannersafearea
---@field back_handler druid.back_handler
---@field button_settings druid.button
---@field button_play druid.button
---@field button_play_text druid.rich_text
---@field widget_counter widget.counter
---@field widget_levelchest_icon widget.event_icon
---@field widget_noads_icon widget.event_icon
---@field widget_accrual widget.accrual
---@field monarch_transition widget.monarch_transition
---@field monarch_focus_listener widget.monarch_focus_listener

local TEXT_LEVELCHEST_ICON_TEXT = "levelchest.icon_text"
local TEXT_NOADS_ICON_TEXT = "noads.icon_text"

local function on_adsservice_interstitial_close(self, placement_id)
	if placement_id == game_const.AD_INTERSTITIAL_PLACEMENTS.LEVEL_START then
		monarch.show(game_const.MONARCH_SCENES.LEVEL, { clear = true })
	end
end

local function on_button_settings()
	monarch.show(game_const.MONARCH_SCENES.SETTINGS)
end

---@param self hud.gui_script
local function on_button_play(self)
	if not adsservice.show_interstitial(game_const.AD_INTERSTITIAL_PLACEMENTS.LEVEL_START) then
		monarch.show(game_const.MONARCH_SCENES.LEVEL, { clear = true })
	end
end

local target_node_original_scale = {}
local function on_emit_to_target(self, token_id, number, amount, target_node)

	target_node_original_scale[token_id] = target_node_original_scale[token_id] or gui.get_scale(target_node)

	gui.set_scale(target_node, target_node_original_scale[token_id])
	gui.animate(target_node, gui.PROP_SCALE, target_node_original_scale[token_id]*1.2, gui.EASING_OUTBOUNCE, 0.1, 0, function()
		gui.set_scale(target_node, target_node_original_scale[token_id])
	end)
end


---@param self hud.gui_script
local function on_focus_gained(self, previous_screen_id)
	--- Если nil, то это первый фокус, на старте игры ничего не показываем
	if previous_screen_id ~= nil then
		self.widget_accrual:accrual()
	end

	if noads.is_purchased() then
		gui.set_enabled(gui.get_node("noads/root"), false)
	else
		gui.set_enabled(gui.get_node("noads/root"), true)
	end
end

---@param self hud.gui_script
local function on_accrual_completed(self)
	-- Показываем окно рейтинга, если его можно показать
	if rateus.show_custom() then
        monarch.show(game_const.MONARCH_SCENES.RATEUS)
	end
end

---@param self hud.gui_script
function init(self)
	msg.post(".", "acquire_input_focus")

	local current_level = level_manager.current_level()

	self.druid = druid.new(self)

	self.safearea = self.druid:new_widget(widget_safearea, nil, nil)
	self.bannersafearea = self.druid:new_widget(widget_bannersafearea, nil, nil)

	self.back_handler = self.druid:new_back_handler(function()
		monarch.show(game_const.MONARCH_SCENES.POPUP_TWO_BUTTONS, nil, {
			title_text_key = "popup.exit.title",
			description_text_key = "popup.exit.description",
			button_left_text_key = "popup.exit.button_left",
			button_left_callback = function()
				monarch.back()
			end,
			button_right_text_key = "popup.exit.button_right",
			button_right_callback = function()
				game.exit()
			end,
		})
	end)
	--- @type druid.button
	self.button_settings = self.druid:new_button("settings/root", on_button_settings)

	------- КНОПКА "Играть" --------
	--- @type druid.button
	self.button_play = self.druid:new_button("play/button", on_button_play, self)

	--- @type druid.lang_text|nil
	self.button_play_text = self.druid:new_lang_text("play/text", "hud.button.play")

	------- СЧЕТЧКИ УРОВНЯ --------
	self.node_level_number = gui.get_node("level_number")
	gui.set_text(self.node_level_number, tostring(current_level.id))


	-------- Виджеты --------
	self.widget_counter = self.druid:new_widget(widget_counter, "gold", nil, game_const.TOKEN.GOLD, function ()
		monarch.show(game_const.MONARCH_SCENES.BANK)
	end)

	---@type game.widget.accrual.data
	local widget_accrual_data = {
		token_targets = {
			[game_const.TOKEN.GOLD] = self.widget_counter.root,
		},
		token_sound_on_target = {
			[game_const.TOKEN.GOLD] = "coins"
		},
		token_sound_on_emit = {
			[game_const.TOKEN.GOLD] = "coins"
		},
		token_vibrate_on_target = {
			[game_const.TOKEN.GOLD] = vibrate.PATTERNS.SUCCESS
		}
	}

	self.widget_accrual = self.druid:new_widget(widget_accrual, nil, nil, widget_accrual_data)
	self.widget_accrual.on_emit_to_target:subscribe(on_emit_to_target, self)
	self.widget_accrual.on_emit_completed:subscribe(on_accrual_completed, self)

	-- Если есть level chest или есть что забрать из него - создаём виджет
	if levelchest.get_current() then
		--- @type widget.event_icon
		self.widget_levelchest_icon = self.druid:new_widget(widget_event_icon, "levelchest", nil, TEXT_LEVELCHEST_ICON_TEXT, game_const.MONARCH_SCENES.LEVEL_CHEST)
	else
		gui.set_enabled(gui.get_node("levelchest/root"), false)
	end

	--- @type widget.event_icon
	self.widget_noads_icon = self.druid:new_widget(widget_event_icon, "noads", nil, TEXT_NOADS_ICON_TEXT, game_const.MONARCH_SCENES.NOADS)
	if noads.is_purchased() then
		gui.set_enabled(gui.get_node("noads/root"), false)
	else
		gui.set_enabled(gui.get_node("noads/root"), true)
	end
	
	-- Конфигурация переходов лежит в assets/monarch.json
	self.monarch_transition = self.druid:new_widget(widget_monarch_transition, nil, nil, game_const.MONARCH_SCENES.HUD)
	self.monarch_focus_listener = self.druid:new_widget(widget_monarch_focus_listener, nil, nil, game_const.MONARCH_SCENES.HUD)
	self.monarch_focus_listener.on_focus_gained:subscribe(on_focus_gained, self)

	adsservice.on_interstitial_close:subscribe(on_adsservice_interstitial_close, self)
end

function final(self)
	self.druid:final()
	adsservice.on_interstitial_close:unsubscribe(on_adsservice_interstitial_close, self)
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
	monarch.on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end

function on_reload(self)
	self.druid:on_reload()
end
